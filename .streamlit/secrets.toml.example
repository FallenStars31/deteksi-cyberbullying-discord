# CONTOH konfigurasi database untuk PRODUKSI (Supabase / Postgres).
# Cara pakai:
#   1. Salin berkas ini menjadi `.streamlit/secrets.toml` (tanpa .example).
#   2. Ganti nilai di bawah dengan connection string Supabase Anda
#      (Supabase → Project Settings → Database → Connection string → URI).
#   3. Di Streamlit Community Cloud: tempel isi ini di menu App → Settings → Secrets.
#
# Bila berkas secrets.toml TIDAK ada, aplikasi otomatis memakai SQLite lokal
# (hasil/app.db) — cocok untuk membangun & mencoba di komputer sendiri.
#
# JANGAN commit secrets.toml asli ke GitHub (sudah masuk .gitignore).

# CARA MUDAH (disarankan): tulis komponen terpisah. Sandi DITULIS APA ADANYA
# (karakter '@' dll tidak perlu di-encode; kode meng-encode otomatis).
[db]
user = "postgres.jemackjxcjomdbpurqcf"
password = "SANDI-SUPABASE-ANDA"
host = "aws-0-ap-southeast-2.pooler.supabase.com"
port = 5432
database = "postgres"

# ALTERNATIF: satu connection string utuh (sandi HARUS di-encode, '@' -> %40):
# [db]
# url = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres"

# ALTERNATIF LOKAL (XAMPP/MySQL, mis. untuk demo/sidang) — root tanpa sandi,
# database 'cyberbullying'. Pastikan MySQL di XAMPP menyala.
# [db]
# url = "mysql+pymysql://root@localhost:3306/cyberbullying"

# (opsional) Gerbang kata sandi aplikasi. Bila baris [app] di bawah diisi,
# aplikasi meminta kata sandi ini sebelum bisa dibuka. Hapus/biarkan kosong
# untuk membuka bebas. Di lokal tanpa berkas ini, aplikasi tidak minta sandi.
[app]
password = "ganti-dengan-kata-sandi-anda"
